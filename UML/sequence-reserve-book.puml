@startuml
!theme plain
skinparam defaultFontName 微软雅黑
skinparam classAttributeFontName 微软雅黑
skinparam noteFontName 宋体
title 顺序图：预约图书（UC-013，含取消预约 UC-014）
skinparam linetype ortho
autonumber

' 对应规格：specs/12-sequence-reserve-book.puml（本文件为仓库根目录展示版）
' 参与对象对齐实验指导书列举：Reader / BookTitle / Reservation 领域对象均已显式表达
' alt/else 分支：读者不存在、标题不存在、重复预约、已借同标题、取消预约

actor "读者" as ReaderActor

participant "ReservationController" as Ctrl
participant "ReservationService" as Svc
participant "ReaderRepository" as ReaderRepo
participant "BookTitleRepository" as TitleRepo
participant "ReservationRepository" as ResvRepo
participant "LoanRepository" as LoanRepo
participant "Reader" as Reader
participant "BookTitle" as Book
participant "Reservation" as Resv

== 1. 请求与身份校验 ==

ReaderActor -> Ctrl : POST /api/reservations\n{title_id}\nHeader: Bearer token
Ctrl -> Svc : create(title_id, operator)

alt 未携带或无效令牌
    Svc --> Ctrl : raise PermissionDeniedError
    Ctrl --> ReaderActor : 403 请先登录
else 身份有效
    Svc -> ReaderRepo : get_by_account(account_id)
    ReaderRepo --> Svc : Reader | None

    alt 读者不存在（账号未办理借阅证 / 读者已注销）
        Svc --> Ctrl : raise NotFoundError
        Ctrl --> ReaderActor : 404 未找到读者档案，请先办理借阅证
    else 读者存在
        Svc -> Reader : 校验读者状态
        Reader --> Svc : 可用
    end
end

== 2. 校验图书标题 ==

Svc -> TitleRepo : get(title_id)
TitleRepo --> Svc : BookTitle | None

alt 标题不存在或已下架
    Svc --> Ctrl : raise NotFoundError
    Ctrl --> ReaderActor : 404 图书不存在
else 标题存在
    Svc -> Book : is_reservable()
    Book --> Svc : true
end

== 3. 预约前置校验（BR-007 / BR-009） ==

Svc -> ResvRepo : has_effective(reader_id, title_id)
ResvRepo --> Svc : bool

alt 已存在本人有效预约（重复预约）
    Svc --> Ctrl : raise BusinessError
    Ctrl --> ReaderActor : 400 您已预约过该书
else 无有效预约
    Svc -> LoanRepo : has_active_loan_of_title(reader_id, title_id)
    LoanRepo --> Svc : bool
    alt 已借有同一标题且未归还
        Svc --> Ctrl : raise BusinessError
        Ctrl --> ReaderActor : 400 您已借有该书，无需预约
    else 未持有
        Svc --> Svc : 校验通过
    end
end

== 4. 创建预约（含排队与有效期 BR-008） ==

Svc -> Resv : create(reader_id, title_id, created_at)
activate Resv
Resv -> Resv : expires_at = created_at + 7 天\nstatus = ACTIVE
Resv --> Svc : Reservation
Svc -> ResvRepo : count_effective_before(title_id, created_at)
ResvRepo --> Svc : n
Svc -> Resv : queue_position = n + 1\n（按 created_at 先到先得排队）
deactivate Resv

Svc -> ResvRepo : add(reservation)
ResvRepo --> Svc : reservation_id

alt 提交成功
    Svc -> Svc : commit 事务
    Svc --> Ctrl : ReservationDTO{reservation_id,\nqueue_position, expires_at}
    Ctrl --> ReaderActor : 200 预约成功，当前排在第 {queue_position} 位\n预约保留至 {expires_at}
else 提交失败
    Svc -> Svc : rollback 事务
    Svc --> Ctrl : raise InfrastructureError
    Ctrl --> ReaderActor : 500 系统繁忙，请稍后重试
end

== 5. 扩展：取消预约（UC-014） ==

ReaderActor -> Ctrl : POST /api/reservations/{id}/cancel
Ctrl -> Svc : cancel(reservation_id, operator)
Svc -> ResvRepo : get(reservation_id)

alt 预约不存在
    Svc --> Ctrl : raise NotFoundError
    Ctrl --> ReaderActor : 404 预约不存在
else 非本人预约
    Svc --> Ctrl : raise PermissionDeniedError
    Ctrl --> ReaderActor : 403 无权取消他人预约
else 状态非 ACTIVE
    Svc --> Ctrl : raise BusinessError
    Ctrl --> ReaderActor : 400 该预约已取消或已失效
else 可取消
    Svc -> Resv : cancel()
    activate Resv
    Resv --> Svc : status = CANCELLED
    deactivate Resv
    Svc -> ResvRepo : save()
    Svc --> Ctrl : ReservationDTO
    Ctrl --> ReaderActor : 200 预约已取消
end

note right of Resv
  预约有效期 7 天；
  过期采用读取时惰性判定，
  EXPIRED 不占排队位次、
  不阻塞他人续借
end note

note over ResvRepo
  重复预约与排队均以
  有效预约（ACTIVE 且未过期）为口径统计
end note

@enduml
